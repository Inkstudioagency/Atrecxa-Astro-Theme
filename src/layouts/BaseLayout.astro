---
import '../styles/normalize.css';
import '../styles/webflow.css';
import '../styles/atrecxa.webflow.css';
import '../styles/custom.css';
import ix3InitialStates from '../styles/ix3-initial-states.css?raw';
import SEO from '../components/global/SEO.astro';
import { webflowRuntime } from '../lib/webflow-runtime';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /**
   * Webflow page id. The Webflow IX3 runtime (public/js/webflow/, see src/lib/webflow-runtime.ts) looks up each page's
   * interactions by this id, so every page keeps the id of the template page it came from.
   */
  wfPage: string;
}

const { wfPage, ...seo } = Astro.props;
const runtime = webflowRuntime[wfPage];
if (!runtime) throw new Error(`No Webflow runtime registered for page id ${wfPage} (see src/lib/webflow-runtime.ts)`);
---

<!doctype html>
<html data-wf-page={wfPage} lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...seo} />
    {/* Initial (hidden) states for the IX3 animations; released once the runtime adds .w-mod-ix3 */}
    <style is:inline set:html={ix3InitialStates}></style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Aboreto&family=Inter+Tight:wght@300;400;500;600;700&display=swap"
    />
    <script is:inline>
      !(function (o, c) {
        var n = c.documentElement,
          t = ' w-mod-';
        (n.className += t + 'js'),
          ('ontouchstart' in o || (o.DocumentTouch && c instanceof DocumentTouch)) && (n.className += t + 'touch');
      })(window, document);
    </script>
    <link href="/images/favicon.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: light)" />
    <link href="/images/favicon-dark.png" rel="icon" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link href="/images/favicon-48.png" rel="icon" type="image/png" sizes="48x48" />
    <link href="/images/webclip-180.png" rel="apple-touch-icon" sizes="180x180" />
    <link href="/images/webclip-192.png" rel="icon" type="image/png" sizes="192x192" />
    <link href="/images/webclip.png" rel="icon" type="image/png" sizes="512x512" />
    <link rel="stylesheet" href="/js/lenis.css" />
    <slot name="head" />
  </head>
  <body>
    <slot />
    {/* Interaction runtime (navbar, dropdowns, sliders, lightboxes, tabs, IX3 animations): see src/lib/webflow-runtime.ts */}
    <script is:inline src="/js/jquery-3.5.1.min.js"></script>
    {runtime.map((file) => <script is:inline src={`/js/webflow/${file}`}></script>)}
    <script is:inline src="/js/gsap.min.js"></script>
    <script is:inline src="/js/ScrollTrigger.min.js"></script>
    <script is:inline src="/js/SplitText.min.js"></script>
    <script is:inline src="/js/Observer.min.js"></script>
    <script is:inline src="/js/lenis.min.js"></script>
    <script>
      import '../scripts/site';
      import '../scripts/forms';
    </script>
  </body>
</html>
