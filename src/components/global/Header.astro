---
// Site header (Webflow navbar). Opening/closing the mobile menu and the hover dropdown are handled by the
// Webflow runtime (public/js/webflow/); this component only renders the markup.
// `variant="dark"` is the version used on pages with a light hero (dark links, dark logo and black button).
import PrimaryButton from '../ui/PrimaryButton.astro';
import { currentLink } from '../../lib/nav';
import { headerLinks, headerMenuExtra, dropdownGroups, dropdownUtilityLinks, headerCta } from '../../config/navigation';
import { videos, lightboxJson } from '../../config/videos';

interface Props {
  variant?: 'light' | 'dark';
}

const { variant = 'light' } = Astro.props;
const dark = variant === 'dark';
const { linkClass, ariaCurrent } = currentLink(Astro.url);
const navLinkClass = (href: string) => linkClass(href, dark ? 'navllink dark w-inline-block' : 'navllink w-inline-block');
const logo = dark
  ? {
      src: '/images/Group-320-1.webp',
      alt: 'Abstract geometric logo composed of two interlocking black shapes forming a hexagonal pattern.',
    }
  : {
      src: '/images/Frame-265.webp',
      alt: 'White geometric logo consisting of two interlocking shapes forming a hexagonal design on a black background.',
    };
---

<div data-animation="default" data-collapse="medium" data-duration="400" data-easing="ease" data-easing2="ease" role="banner" class="navigation-bar w-nav">
  <div class="container w-container">
    <div class="nav-headrer-content">
      <div class="nav-header-left-tab">
        <ul role="list" class="nav-header-menu">
          {
            headerLinks.map((link) => (
              <li class="nav-list-item">
                <div class="nav-link-wrap">
                  <a href={link.href} aria-current={ariaCurrent(link.href)} class={navLinkClass(link.href)}>
                    <div>{link.label}</div>
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="header-middle-col">
        <a href="/" aria-current={ariaCurrent('/')} class={linkClass('/', 'brand-link-nav w-nav-brand')}>
          <img alt={logo.alt} src={logo.src} class="brand-logo" />
        </a>
      </div>
      <div class="nav-header-left-col">
        <nav role="navigation" class="header-menu-wrapper w-nav-menu">
          <ul role="list" class="nav-header-menu">
            {
              headerLinks.map((link) => (
                <li class="header-nav-list">
                  <div class="nav-link-wrap">
                    <a href={link.href} aria-current={ariaCurrent(link.href)} class={navLinkClass(link.href)}>
                      <div>{link.label}</div>
                    </a>
                  </div>
                </li>
              ))
            }
            {
              headerMenuExtra.map((link) => (
                <li class="header-nav-list-item">
                  <div class="nav-link-wrap">
                    <a href={link.href} aria-current={ariaCurrent(link.href)} class={navLinkClass(link.href)}>
                      <div>{link.label}</div>
                    </a>
                  </div>
                </li>
              ))
            }
            <li class="header-nav-list-item">
              <div data-delay="0" data-hover="true" class="nav-dropdown w-dropdown">
                <div class:list={['nav-link', dark && 'dark', 'w-dropdown-toggle']}>
                  <div>Pages</div>
                  <div class="nav-link-icon w-icon-dropdown-toggle"></div>
                </div>
                <nav class="nav-dropdown-content v1 w-dropdown-list">
                  <div class="dropdown-menu-wrap">
                    <div class="dropdown-group-wrap">
                      <div class="nav-dropdown-top-block">
                        <div class="dropdown-menu-group">
                          {
                            dropdownGroups.map((group, i) => (
                              <Fragment>
                                {i > 0 && <div class:list={['dropdown-devider', i === 2 && 'hide-tab']} />}
                                <div class="dropdown-menu">
                                  <div class="dropdown-subtitle">{group.title}</div>
                                  <div class="dropdown-menu-main">
                                    {group.links.map((link) => (
                                      <div class="nav-link-wrap">
                                        <a href={link.href} aria-current={ariaCurrent(link.href)} class={linkClass(link.href, 'dropdown-link w-dropdown-link')}>
                                          {link.label}
                                        </a>
                                      </div>
                                    ))}
                                  </div>
                                </div>
                              </Fragment>
                            ))
                          }
                        </div>
                      </div>
                      <div class="dropdown-devider-line"></div>
                      <div class="nav-dropdown-top-block">
                        <div class="utility-link-wrap">
                          {
                            dropdownUtilityLinks.map((link) => (
                              <div class="nav-link-wrap">
                                <a href={link.href} aria-current={ariaCurrent(link.href)} class={linkClass(link.href, 'dropdown-link w-dropdown-link')}>
                                  {link.label}
                                </a>
                              </div>
                            ))
                          }
                        </div>
                      </div>
                    </div>
                    <div class="media-frame dropdown-media">
                      <img sizes="100vw" srcset="/images/Image-45-p-500.webp 500w, /images/Image-45-p-800.webp 800w, /images/Image-45.webp 1077w" alt="" src="/images/Image-45.webp" loading="eager" class="dropdown-menu-image" />
                      <a href="#" class="watch-badge-v1 small w-inline-block w-lightbox" aria-label="Play video">
                        <svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="watch-icon">
                          <path d="M18.8906 12.846C18.5371 14.189 16.8667 15.138 13.5257 17.0361C10.296 18.8709 8.6812 19.7884 7.37983 19.4196C6.8418 19.2671 6.35159 18.9776 5.95624 18.5787C5 17.6139 5 15.7426 5 12C5 8.2574 5 6.3861 5.95624 5.42132C6.35159 5.02245 6.8418 4.73288 7.37983 4.58042C8.6812 4.21165 10.296 5.12907 13.5257 6.96393C16.8667 8.86197 18.5371 9.811 18.8906 11.154C19.0365 11.7084 19.0365 12.2916 18.8906 12.846Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"></path>
                        </svg>
                        <script type="application/json" class="w-json" set:html={lightboxJson(videos.showreel)}></script>
                      </a>
                    </div>
                  </div>
                </nav>
              </div>
            </li>
            <li class="header-nav-list-item hide-tab">
              <PrimaryButton href={headerCta.href} variant={dark ? 'black' : 'base'}>{headerCta.label}</PrimaryButton>
            </li>
          </ul>
        </nav>
        <div class={dark ? 'hamburger-menu-dark w-nav-button' : 'hamburger-menu w-nav-button'}>
          <div class="w-icon-nav-menu"></div>
        </div>
      </div>
    </div>
  </div>
</div>
