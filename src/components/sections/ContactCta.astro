---
import ContactForm from '../ui/ContactForm.astro';
---

<section class="section white">
        <div class="w-layout-blockcontainer container w-container">
          <div class="contact-grid">
            <div class="contact-left">
              <div class="section-head faq">
                <div class="section-badge">
                  <div class="section-badge-mark"></div>
                  <div class="font-label">Contact us</div>
                </div>
                <h2 class="section-heading-v1">Your next Property Awaits</h2>
                <div class="cta-summary-wrap">
                  <p to-top-2="" class="font-regular">Welcome to the future of real estate! our selection of futuristic houses is designed to meet the needs of the modern homeowner.</p>
                </div>
              </div>
            </div>
            <div class="contact-right"><img src="/images/Image-25.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px" srcset="/images/Image-25-p-500.webp 500w, /images/Image-25-p-800.webp 800w, /images/Image-25.webp 1608w" alt="Single-storey stone and glass house at sunset, with the low sun reflecting across its full-height windows and a concrete path leading to the entrance" class="cta-image" />
              <div class="contact-form-wrap">
                <div class="contact-form-header">
                  <div class="contact-form-title">Envision Your property</div>
                  <div class="contact-header-text">we will contact you as soon as possible.</div>
                </div>
                <ContactForm />
                <div class="contact-bottom-text">By sending your request, you're agreeing to our privacy policy. We promise to keep your personal information safe and secure</div>
              </div>
            </div>
          </div>
        </div>
      </section>
