---
import PrimaryButton from '../ui/PrimaryButton.astro';
---

<section data-wf-component-id="3f060ec7-45aa-dfb0-880a-7f3e5fc5bae3" data-wf-variant-state="base" class="section cta">
      <div class="section-gap band">
        <div class="container">
          <div class="cta-v2-content">
            <div class="section-badge">
              <div class="section-badge-mark white"></div>
              <p class="font-label white">Contact Us</p>
            </div>
            <h2 class="cta-heading">Your next property awaits</h2>
            <p class="font-regular white max-width-34">Welcome to the future of real estate. Our selection of futuristic houses is designed to meet the needs of the modern homeowner.</p>
            <div class="cta-button-wrap">
              <PrimaryButton href="/contact-us">Get in touch</PrimaryButton>
            </div>
          </div>
        </div>
      </div><img src="/images/Image-44.webp" loading="lazy" sizes="100vw" srcset="/images/Image-44-p-500.webp 500w, /images/Image-44-p-800.webp 800w, /images/Image-44-p-1080.webp 1080w, /images/Image-44-p-1600.webp 1600w, /images/Image-44-p-2000.webp 2000w, /images/Image-44.webp 2160w" alt="Modern house with large glass windows and wooden exterior elevated on a concrete pillar on a rocky coastline at dusk with lights glowing inside." class="cta-image-v2" />
      <div class="cta-v2-overlay"></div>
    </section>
