---
import { videos, lightboxJson } from '../../config/videos';
import reviewLogo1Svg from '../../assets/svg/review-logo-1.svg?raw';
import reviewLogo2Svg from '../../assets/svg/review-logo-2.svg?raw';
---

<section class="section testimonials-v2">
        <div class="section-gap large">
          <div class="container">
            <div class="v2-section-stack">
              <div class="head-center left">
                <div class="section-badge">
                  <div class="section-badge-mark white"></div>
                  <p class="font-label white">Testimonials</p>
                </div>
                <h2 class="section-heading-large white left">Our client words</h2>
              </div>
              <div data-delay="100" data-animation="slide" class="slider-v3 w-slider" data-autoplay="false" to-top-0="" data-easing="ease" data-hide-arrows="false" data-disable-swipe="false" data-autoplay-limit="1" data-nav-spacing="3" data-duration="500" data-infinite="true">
                <div class="slider-mask-v3 w-slider-mask">
                  <div class="testimonial-slide-v3 w-slide">
                    <div class="testimonial-v3-card">
                      <a href="#" class="testimonial-v3-play w-inline-block w-lightbox">
                        <div class="arrow-small w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="17" viewBox="0 0 14 17" fill="none">
                            <path d="M13 7.634a1 1 0 0 1 0 1.732L1.75 15.86A1 1 0 0 1 .25 15V1.999A1 1 0 0 1 1.75 1.13L13 7.634Z" fill="currentColor"></path>
                          </svg></div>
                        <script type="application/json" class="w-json" set:html={lightboxJson(videos.showreel)}></script>
                      </a>
                      <div class="testimonial-v3-body">
                        <p class="review-text">“What impressed us most was how organized the entire process was. The team handled the design, materials, and execution while keeping us informed at every step.”</p>
                        <div class="review-devider-line"></div>
                        <div class="review-bottom">
                          <div class="testimonial-v2-author"><img alt="A woman with long blonde hair sits on a textured cream sofa, wearing a light blue button-up shirt, white pants, and white sneakers, holding a gray cup in one hand and reading a magazine in the other, with natural light coming from a nearby window illuminating the cozy room." src="/images/Frame-2147235149-2.webp" sizes="(max-width: 944px) 100vw, 944px" srcset="/images/Frame-2147235149-2-p-500.webp 500w, /images/Frame-2147235149-2-p-800.webp 800w, /images/Frame-2147235149-2.webp 944w" class="testimonial-v3-avatar" />
                            <div class="text-stack review">
                              <div class="reviewer-name-text">Jenny Wilson</div>
                              <div class="font-regular">Interior Designer</div>
                            </div>
                          </div>
                          <div class="review-logo-wrap"><Fragment set:html={reviewLogo1Svg} />
                            <div class="rating-number">4.9</div><Fragment set:html={reviewLogo2Svg} />
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="testimonial-slide-v3 w-slide">
                    <div class="testimonial-v3-card _02">
                      <a href="#" class="testimonial-v2-play w-inline-block w-lightbox">
                        <div class="arrow-small w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="17" viewBox="0 0 14 17" fill="none">
                            <path d="M13 7.634a1 1 0 0 1 0 1.732L1.75 15.86A1 1 0 0 1 .25 15V1.999A1 1 0 0 1 1.75 1.13L13 7.634Z" fill="currentColor"></path>
                          </svg></div>
                        <script type="application/json" class="w-json" set:html={lightboxJson(videos.showreel)}></script>
                      </a>
                      <div class="testimonial-v3-body">
                        <p class="review-text">“We had a clear idea of the feeling we wanted, but didn’t know how to bring it together. The team translated our ideas into a beautiful, functional home that feels completely ours.”</p>
                        <div class="review-devider-line"></div>
                        <div class="review-bottom">
                          <div class="testimonial-v2-author"><img alt="A young man in a beige suit sits relaxed in a vintage armchair on a fluffy carpet in an elegant room with decorated walls and large windows in the background." src="/images/Frame-2147235151.webp" sizes="(max-width: 1416px) 100vw, 1416px" srcset="/images/Frame-2147235151-p-500.webp 500w, /images/Frame-2147235151-p-800.webp 800w, /images/Frame-2147235151-p-1080.webp 1080w, /images/Frame-2147235151.webp 1416w" class="testimonial-v3-avatar" />
                            <div class="text-stack review">
                              <div class="reviewer-name-text">Jane Cooper</div>
                              <div class="font-regular">Interior Designer</div>
                            </div>
                          </div>
                          <div class="review-logo-wrap"><Fragment set:html={reviewLogo1Svg} />
                            <div class="rating-number">4.9</div><Fragment set:html={reviewLogo2Svg} />
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="testimonial-slide-v3 w-slide">
                    <div class="testimonial-v3-card _03">
                      <a href="#" class="testimonial-v2-play w-inline-block w-lightbox">
                        <div class="arrow-small w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="17" viewBox="0 0 14 17" fill="none">
                            <path d="M13 7.634a1 1 0 0 1 0 1.732L1.75 15.86A1 1 0 0 1 .25 15V1.999A1 1 0 0 1 1.75 1.13L13 7.634Z" fill="currentColor"></path>
                          </svg></div>
                        <script type="application/json" class="w-json" set:html={lightboxJson(videos.showreel)}></script>
                      </a>
                      <div class="testimonial-v3-body">
                        <p class="review-text">“From the material selection to the lighting and furniture, everything was thoughtfully considered. The final space feels sophisticated without ever losing its warmth.”</p>
                        <div class="review-devider-line"></div>
                        <div class="review-bottom">
                          <div class="testimonial-v2-author"><img alt="Young woman with long red hair wearing a white wrap dress with three-quarter sleeves, walking outdoors near white walls and green plants." src="/images/Frame-2147235148.webp" sizes="(max-width: 1416px) 100vw, 1416px" srcset="/images/Frame-2147235148-p-500.webp 500w, /images/Frame-2147235148-p-800.webp 800w, /images/Frame-2147235148-p-1080.webp 1080w, /images/Frame-2147235148.webp 1416w" class="testimonial-v3-avatar" />
                            <div class="text-stack review">
                              <div class="reviewer-name-text">Sophia Cooper</div>
                              <div class="font-regular">Lead Architect</div>
                            </div>
                          </div>
                          <div class="review-logo-wrap"><Fragment set:html={reviewLogo1Svg} />
                            <div class="rating-number">4.9</div><Fragment set:html={reviewLogo2Svg} />
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="testimonial-slide-v3 w-slide">
                    <div class="testimonial-v3-card _04">
                      <a href="#" class="testimonial-v2-play w-inline-block w-lightbox">
                        <div class="arrow-small w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="14" height="17" viewBox="0 0 14 17" fill="none">
                            <path d="M13 7.634a1 1 0 0 1 0 1.732L1.75 15.86A1 1 0 0 1 .25 15V1.999A1 1 0 0 1 1.75 1.13L13 7.634Z" fill="currentColor"></path>
                          </svg></div>
                        <script type="application/json" class="w-json" set:html={lightboxJson(videos.showreel)}></script>
                      </a>
                      <div class="testimonial-v3-body">
                        <p class="review-text">“They gave us a plan we could actually live in rather than a showpiece. Two years on, the rooms still work exactly as promised and nothing has needed undoing.”</p>
                        <div class="review-devider-line"></div>
                        <div class="review-bottom">
                          <div class="testimonial-v2-author"><img alt="Woman with pale skin and short red hair wearing a beige turtleneck sweater and a brown coat, looking to the side against a plain light gray background." src="/images/Image-Design-yours-8.webp" sizes="(max-width: 1107px) 100vw, 1107px" srcset="/images/Image-Design-yours-8-p-500.webp 500w, /images/Image-Design-yours-8-p-800.webp 800w, /images/Image-Design-yours-8-p-1080.webp 1080w, /images/Image-Design-yours-8.webp 1107w" class="testimonial-v3-avatar" />
                            <div class="text-stack review">
                              <div class="reviewer-name-text">Sophia Bennett</div>
                              <div class="font-regular">Design Director</div>
                            </div>
                          </div>
                          <div class="review-logo-wrap"><Fragment set:html={reviewLogo1Svg} />
                            <div class="rating-number">4.9</div><Fragment set:html={reviewLogo2Svg} />
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
                <div class="testimonial-slider-button-v3 left w-slider-arrow-left"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="arrow-icon">
                    <path d="M5.5 12.002H19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M10.9999 18.002C10.9999 18.002 5.00001 13.583 5 12.0019C4.99999 10.4208 11 6.00195 11 6.00195" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg></div>
                <div class="testimonial-slider-button-v3 right w-slider-arrow-right"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="arrow">
                    <path d="M18.5 11.998L5 11.998" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    <path d="M13.0001 5.998C13.0001 5.998 19 10.417 19 11.9981C19 13.5792 13 17.998 13 17.998" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                  </svg></div>
                <div class="slider-nav w-slider-nav w-round w-num"></div>
              </div>
            </div>
          </div>
        </div>
      </section>
