---

---

<section class="section inverse">
        <div class="section-gap large">
          <div class="w-layout-blockcontainer container w-container">
            <div class="section-head">
              <div class="section-badge">
                <div class="section-badge-mark white"></div>
                <div class="font-label white">Testimonials</div>
              </div>
              <h2 class="section-heading-v1 white-300">Our client words</h2>
            </div>
            <div to-top-0="" class="testimonial-frame">
              <div class="testimonial-slot-v1">
                <div data-delay="4000" data-animation="fade" class="testimonial-slider w-slider" data-autoplay="false" data-easing="ease" data-hide-arrows="false" data-disable-swipe="false" data-autoplay-limit="0" data-nav-spacing="3" data-duration="500" data-infinite="true">
                  <div class="testimonial-mask w-slider-mask">
                    <div class="testimonial-slide w-slide">
                      <div class="teatimonial-card-main">
                        <div class="testimonial-card">
                          <div class="testimonial-body">
                            <div class="quote-mark">
                              <div class="w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="36" height="28" viewBox="0 0 36 28" fill="none">
                                  <path d="M0 28V14.6C0 6.5 4.9 1 13.3 0l1.2 4.6C9.9 5.9 7.6 8.7 7.6 12.4h6.5V28H0Zm21.9 0V14.6C21.9 6.5 26.8 1 35.2 0l1.2 4.6c-4.6 1.3-6.9 4.1-6.9 7.8h6.5V28H21.9Z" fill="currentColor"></path>
                                </svg></div>
                            </div>
                            <p class="testimonial-summary">In six months they took us from a first sketch to a signed planning consent. The programme never slipped, and the costs we were shown at the very start are the costs we paid at the end.</p>
                            <div class="divider-line"></div>
                          </div>
                          <div class="testimonial-author"><img src="/images/Ellipse-19.webp" loading="lazy" alt="Smiling young woman with long straight light brown hair wearing a denim jacket and striped shirt, indoors with a blurred bright background." class="avatar" />
                            <div class="reviewer-name">Jane Cooper</div>
                            <div class="font-small">Marketing Coordinator</div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="testimonial-slide w-slide">
                      <div class="teatimonial-card-main _02">
                        <div class="testimonial-card">
                          <div class="testimonial-body">
                            <div class="quote-mark">
                              <div class="w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="36" height="28" viewBox="0 0 36 28" fill="none">
                                  <path d="M0 28V14.6C0 6.5 4.9 1 13.3 0l1.2 4.6C9.9 5.9 7.6 8.7 7.6 12.4h6.5V28H0Zm21.9 0V14.6C21.9 6.5 26.8 1 35.2 0l1.2 4.6c-4.6 1.3-6.9 4.1-6.9 7.8h6.5V28H21.9Z" fill="currentColor"></path>
                                </svg></div>
                            </div>
                            <p class="testimonial-summary">The team translated a complicated brief into a building that works day to day. Detailing was resolved early, the site ran calmly, and the handover was the easiest part of the whole project.</p>
                            <div class="divider-line"></div>
                          </div>
                          <div class="testimonial-author"><img src="/images/Image-Design-yours-4.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px" srcset="/images/Image-Design-yours-4-p-500.webp 500w, /images/Image-Design-yours-4-p-800.webp 800w, /images/Image-Design-yours-4-p-1080.webp 1080w, /images/Image-Design-yours-4.webp 1230w" alt="Man in a white hard hat and black suit holding blueprints and looking to the side in front of colorful apartment buildings." class="avatar" />
                            <div class="reviewer-name">Devon Lane</div>
                            <div class="font-small">Development Director</div>
                          </div>
                        </div>
                      </div>
                    </div>
                    <div class="testimonial-slide w-slide">
                      <div class="teatimonial-card-main _03">
                        <div class="testimonial-card">
                          <div class="testimonial-body">
                            <div class="quote-mark">
                              <div class="w-embed"><svg xmlns="http://www.w3.org/2000/svg" width="36" height="28" viewBox="0 0 36 28" fill="none">
                                  <path d="M0 28V14.6C0 6.5 4.9 1 13.3 0l1.2 4.6C9.9 5.9 7.6 8.7 7.6 12.4h6.5V28H0Zm21.9 0V14.6C21.9 6.5 26.8 1 35.2 0l1.2 4.6c-4.6 1.3-6.9 4.1-6.9 7.8h6.5V28H21.9Z" fill="currentColor"></path>
                                </svg></div>
                            </div>
                            <p class="testimonial-summary">“From the first sketch to the final detail, the process felt effortless. The team understood our vision, solved problems quickly, and delivered a space that feels refined and practical.”</p>
                            <div class="divider-line"></div>
                          </div>
                          <div class="testimonial-author"><img src="/images/Image-42.webp" loading="lazy" alt="Young woman with wavy brown hair smiling, wearing a gray shirt, with an outdoor blurred background." class="avatar" />
                            <div class="reviewer-name">Maya Bennett<br /></div>
                            <div class="font-small">Project Manager</div>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="slider-arrow w-slider-arrow-left"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="slider-arrow-icon">
                      <path d="M5.5 12.002L19 12.002" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M10.9999 18.002C10.9999 18.002 5.00001 13.583 5 12.0019C4.99999 10.4208 11 6.00195 11 6.00195" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg></div>
                  <div class="slider-arrow right w-slider-arrow-right"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 24 24" fill="none" class="slider-arrow-icon">
                      <path d="M18.5 11.998L5 11.998" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                      <path d="M13.0001 5.998C13.0001 5.998 19 10.417 19 11.9981C19 13.5792 13 17.998 13 17.998" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg></div>
                  <div class="slider-nav w-slider-nav w-round w-num"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
