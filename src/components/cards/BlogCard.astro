---
// Blog card used in the "Latest Articles" sections (Home V1, About V1).
import type { Blog } from '../../lib/cms';
import { mediaSrc, mediaSrcset, mediaAlt, formatDate } from '../../lib/cms';
import ArrowPill from '../ui/ArrowPill.astro';

interface Props {
  item: Blog;
  /** Scroll-in animation (Webflow IX3 `to-top-0`). */
  animate?: boolean;
}

const { item, animate = true } = Astro.props;
const url = `/blog/${item.slug}`;
---

<div to-top-0={animate ? '' : undefined} class="blog-card">
  <a href={url} class="blog-media w-inline-block">
    <img src={mediaSrc(item.image)} sizes="(max-width: 767px) 100vw, (max-width: 991px) 727px, 939px" srcset={mediaSrcset(item.image)} alt={mediaAlt(item.image)} loading="lazy" class="media-image" />
    <div class="demo">#</div>
  </a>
  <div class="blog-meta-wrap">
    <div class="blog-meta">
      <p class="font-extra-normal black-900">{formatDate(item.date)}</p>
      <p class="font-small">•</p>
      <p class="font-extra-normal">{item.category}</p>
    </div>
    <a href={url} class="expert-v2-button w-inline-block" aria-label={item.title}>
      <ArrowPill />
      <div class="demo">#</div>
    </a>
  </div>
  <div class="divider-line"></div>
  <a href={url} class="blog-title-link w-inline-block">
    <div class="card-title body-font">{item.title}</div>
    <div class="demo">#</div>
  </a>
</div>
