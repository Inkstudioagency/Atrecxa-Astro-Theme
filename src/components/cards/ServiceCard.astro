---
// Service card on Services V1.
import type { Service } from '../../lib/cms';
import { mediaSrc, mediaSrcset, mediaAlt } from '../../lib/cms';

interface Props {
  item: Service;
}

const { item } = Astro.props;
const url = `/service/${item.slug}`;
---

<div class="service-card">
  <div class="service-grid-v1">
    <a href={url} class="service-media w-inline-block">
      <img src={mediaSrc(item.image)} sizes="(max-width: 767px) 100vw, (max-width: 991px) 727px, 939px" srcset={mediaSrcset(item.image)} alt={mediaAlt(item.image)} loading="lazy" class="service-card-image-v1" />
      <div class="demo">#</div>
    </a>
    {/* The id is the grid placement hook styled in atrecxa.webflow.css. */}
    <div id="w-node-b0f7e8aa-f9e4-3956-b51b-35b285a2baa8-e5be92d8" class="service-content">
      <div class="service-head">
        <a href={url} class="service-titile-link w-inline-block">
          <div to-top-0="" class="about-rebuild-text service-title">{item.title}</div>
          <div class="demo">#</div>
        </a>
        <p to-top-0="" class="font-regular">{item.shortDescription}</p>
      </div>
      <a href={url} class="learn-more-button w-inline-block">
        <div>View Service</div>
      </a>
    </div>
  </div>
</div>
