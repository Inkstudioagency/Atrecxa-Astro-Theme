---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import awardLogo10Svg from '../assets/svg/award-logo-10.svg?raw';
import awardLogo11Svg from '../assets/svg/award-logo-11.svg?raw';
import awardLogo12Svg from '../assets/svg/award-logo-12.svg?raw';
import awardLogo13Svg from '../assets/svg/award-logo-13.svg?raw';
import TestimonialsV3 from '../components/sections/TestimonialsV3.astro';
import FaqV3 from '../components/sections/FaqV3.astro';
import LatestArticlesV3 from '../components/sections/LatestArticlesV3.astro';
import CtaV3 from '../components/sections/CtaV3.astro';
import Footer from '../components/global/Footer.astro';
---

<BaseLayout title="About Us V3 - Atrecxa - Astro Theme" description="About Us V3 page of the Atrecxa Astro theme — a cleaner studio story layout covering your journey, values, awards and design team." wfPage="6aa2bc98123b655f64c9cd77">
<div class="page-wrapper">
    <div class="about-hero-v3">
      <Header />
      <section class="section hero">
        <div class="hero-v3-band">
          <div class="container">
            <div class="hero-v3-row">
              <div class="hero-v3-title-wrap">
                <h1 class="hero-heading-v3">Our Story</h1>
              </div>
            </div>
          </div>
        </div>
      </section><img src="/images/Rectangle-2-2.webp" loading="eager" sizes="(max-width: 2880px) 100vw, 2880px" srcset="/images/Rectangle-2-2-p-500.webp 500w, /images/Rectangle-2-2-p-800.webp 800w, /images/Rectangle-2-2-p-1080.webp 1080w, /images/Rectangle-2-2-p-1600.webp 1600w, /images/Rectangle-2-2-p-2000.webp 2000w, /images/Rectangle-2-2.webp 2880w" alt="Spacious modern living room with large floor-to-ceiling windows showing outdoor pool and garden, neutral-toned sectional sofas with cushions around a low round wooden coffee table on a beige rug, high ceiling with black woven pendant light, and a dining area with a wooden table and chairs near the kitchen in the background." class="inner-hero-image" />
      <div class="inner-hero-overlay-v3"></div>
    </div>
    <div class="main">
      <section class="section white">
        <div class="section-gap large">
          <div class="v2-section-stack">
            <div class="container">
              <div class="intro-v2-head services-v3">
                <div to-top-0="" class="section-badge">
                  <div class="section-badge-mark"></div>
                  <p class="font-label">Services</p>
                </div>
                <h2 class="rebuild-text">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;We Create Interiors That Mix Style Comfort, And Practicality. We're All About The Little Details And Timeless Vibes.</h2>
              </div>
            </div>
            <div class="container">
              <div to-top-0="" class="trusted-v3-row">
                <div class="trusted-v3-label">
                  <p class="about-stats-title center-mobile">Trusted by industry-leading Brands</p>
                </div>
                <div class="trusted-v3-logos"></div>
                <div class="marque-wrap">
                  <div class="marque-list"><img src="/images/Company-logo-7.webp" loading="lazy" alt="Eclipseful" class="company-logo-image" /><img src="/images/Company-logo-5.webp" loading="lazy" alt="Capsule company logo." class="company-logo-image" /><img src="/images/Company-logo-8.webp" loading="lazy" alt="Foresight" class="company-logo-image" /><img src="/images/Company-logo-6.webp" loading="lazy" alt="CloudWatch logo showing a stylized cloud icon followed by the word 'CloudWatch' in bold black font." class="company-logo-image" /><img src="/images/Company-logo.webp" loading="lazy" alt="Goodwell company logo with a stylized lowercase 'g' icon to the left of the word 'Goodwell'." class="company-logo-image" /><img src="/images/Company-logo-2.webp" loading="lazy" alt="Railspeed company logo with stylized horizontal bars next to the word Railspeed." class="company-logo-image" /><img src="/images/Company-logo-4.webp" loading="lazy" alt="Leapyear company logo with a stylized geometric icon to the left of the word 'Leapyear' in bold black font." class="company-logo-image" /><img src="/images/Company-logo-1.webp" loading="lazy" alt="Radius company logo with a starburst design to the left of the word Radius in bold font." class="company-logo-image" /><img src="/images/Company-logo-3.webp" loading="lazy" alt="Norse Star company logo with a black abstract star symbol followed by the words 'Norse Star' in black text." class="company-logo-image" /></div>
                  <div class="marque-list"><img src="/images/Company-logo-7.webp" loading="lazy" alt="Eclipseful" class="company-logo-image" /><img src="/images/Company-logo-5.webp" loading="lazy" alt="Capsule company logo." class="company-logo-image" /><img src="/images/Company-logo-8.webp" loading="lazy" alt="Foresight" class="company-logo-image" /><img src="/images/Company-logo-6.webp" loading="lazy" alt="CloudWatch logo showing a stylized cloud icon followed by the word 'CloudWatch' in bold black font." class="company-logo-image" /><img src="/images/Company-logo.webp" loading="lazy" alt="Goodwell company logo with a stylized lowercase 'g' icon to the left of the word 'Goodwell'." class="company-logo-image" /><img src="/images/Company-logo-2.webp" loading="lazy" alt="Railspeed company logo with stylized horizontal bars next to the word Railspeed." class="company-logo-image" /><img src="/images/Company-logo-4.webp" loading="lazy" alt="Leapyear company logo with a stylized geometric icon to the left of the word 'Leapyear' in bold black font." class="company-logo-image" /><img src="/images/Company-logo-1.webp" loading="lazy" alt="Radius company logo with a starburst design to the left of the word Radius in bold font." class="company-logo-image" /><img src="/images/Company-logo-3.webp" loading="lazy" alt="Norse Star company logo with a black abstract star symbol followed by the words 'Norse Star' in black text." class="company-logo-image" /></div>
                  <div class="marque-overlay"></div>
                  <div class="marque-overlay right"></div>
                </div>
              </div>
            </div>
            <div to-top-0="" class="marque-list-wrap">
              <div class="image-marque-list"><img src="/images/Container-19.webp" alt="A blonde woman dressed in black leans over a wooden table reviewing architectural blueprints with fabric and material samples spread out beside them, in a bright room with a window and tablet on the table." sizes="(max-width: 1008px) 100vw, 1008px" srcset="/images/Container-19-p-500.webp 500w, /images/Container-19-p-800.webp 800w, /images/Container-19.webp 1008w" loading="lazy" class="marque-image" /><img src="/images/Container-20.webp" alt="Four people gathered around a large table studying a detailed wooden architectural model with buildings and terrain, set in a room with large windows showing trees and city buildings outside." sizes="(max-width: 1008px) 100vw, 1008px" srcset="/images/Container-20-p-500.webp 500w, /images/Container-20-p-800.webp 800w, /images/Container-20.webp 1008w" loading="lazy" class="marque-image" /><img src="/images/Container-21.webp" alt="A group of six diverse colleagues are gathered around a table in a bright office, discussing and pointing at architectural blueprints." sizes="(max-width: 1008px) 100vw, 1008px" srcset="/images/Container-21-p-500.webp 500w, /images/Container-21-p-800.webp 800w, /images/Container-21.webp 1008w" loading="lazy" class="marque-image" /><img src="/images/Container-22.webp" alt="Workspace with tables covered in design materials, including booklets, rolls of paper, color swatches, and sketches, with a whiteboard filled with samples and diagrams in a room with brick walls." sizes="(max-width: 1344px) 100vw, 1344px" srcset="/images/Container-22-p-500.webp 500w, /images/Container-22-p-800.webp 800w, /images/Container-22-p-1080.webp 1080w, /images/Container-22.webp 1344w" loading="lazy" class="marque-image" /><img src="/images/Container-23.webp" alt="Three people sitting at a table reviewing a sample book displaying color swatches labeled Finish A and Finish B in shades of beige and peach." sizes="(max-width: 1344px) 100vw, 1344px" srcset="/images/Container-23-p-500.webp 500w, /images/Container-23-p-800.webp 800w, /images/Container-23-p-1080.webp 1080w, /images/Container-23.webp 1344w" loading="lazy" class="marque-image" /></div>
              <div class="image-marque-list"><img src="/images/Container-19.webp" alt="A blonde woman dressed in black leans over a wooden table reviewing architectural blueprints with fabric and material samples spread out beside them, in a bright room with a window and tablet on the table." sizes="(max-width: 1008px) 100vw, 1008px" srcset="/images/Container-19-p-500.webp 500w, /images/Container-19-p-800.webp 800w, /images/Container-19.webp 1008w" loading="lazy" class="marque-image" /><img src="/images/Container-20.webp" alt="Four people gathered around a large table studying a detailed wooden architectural model with buildings and terrain, set in a room with large windows showing trees and city buildings outside." sizes="(max-width: 1008px) 100vw, 1008px" srcset="/images/Container-20-p-500.webp 500w, /images/Container-20-p-800.webp 800w, /images/Container-20.webp 1008w" loading="lazy" class="marque-image" /><img src="/images/Container-21.webp" alt="A group of six diverse colleagues are gathered around a table in a bright office, discussing and pointing at architectural blueprints." sizes="(max-width: 1008px) 100vw, 1008px" srcset="/images/Container-21-p-500.webp 500w, /images/Container-21-p-800.webp 800w, /images/Container-21.webp 1008w" loading="lazy" class="marque-image" /><img src="/images/Container-22.webp" alt="Workspace with tables covered in design materials, including booklets, rolls of paper, color swatches, and sketches, with a whiteboard filled with samples and diagrams in a room with brick walls." sizes="(max-width: 1344px) 100vw, 1344px" srcset="/images/Container-22-p-500.webp 500w, /images/Container-22-p-800.webp 800w, /images/Container-22-p-1080.webp 1080w, /images/Container-22.webp 1344w" loading="lazy" class="marque-image" /><img src="/images/Container-23.webp" alt="Three people sitting at a table reviewing a sample book displaying color swatches labeled Finish A and Finish B in shades of beige and peach." loading="lazy" class="marque-image" /></div>
            </div>
            <div class="container">
              <div to-top-0="" data-current="Tab 1" data-easing="ease" data-duration-in="300" data-duration-out="100" class="mission-tab w-tabs">
                <div class="mission-tab-menu w-tab-menu">
                  <a data-w-tab="Tab 1" class="mission-tab-link w-inline-block w-tab-link w--current">
                    <div>Our mission</div>
                  </a>
                  <a data-w-tab="Tab 2" class="mission-tab-link w-inline-block w-tab-link">
                    <div>Our Vision</div>
                  </a>
                  <a data-w-tab="Tab 3" class="mission-tab-link w-inline-block w-tab-link">
                    <div>Our Philosophy</div>
                  </a>
                </div>
                <div class="w-tab-content">
                  <div data-w-tab="Tab 1" class="w-tab-pane w--tab-active">
                    <div class="w-layout-grid mission-grid">
                      <div class="mission-left">
                        <div class="mission-v3-foot">
                          <div class="divider-line mission"></div>
                          <p class="mission-summary">To design buildings and interiors as one act of thinking, with a single team holding the drawing, the budget and the build throughout.</p>
                        </div>
                      </div>
                      <div class="mission-right"><img src="/images/Image-single-image-7.webp" loading="lazy" sizes="100vw" srcset="/images/Image-single-image-7-p-500.webp 500w, /images/Image-single-image-7-p-800.webp 800w, /images/Image-single-image-7-p-1080.webp 1080w, /images/Image-single-image-7-p-1600.webp 1600w, /images/Image-single-image-7-p-2000.webp 2000w, /images/Image-single-image-7.webp 2320w" alt="Two people sitting at a desk looking at a desktop computer screen displaying a floor plan; one person points at the screen with a pen." class="mission-image" /></div>
                    </div>
                  </div>
                  <div data-w-tab="Tab 2" class="w-tab-pane">
                    <div class="w-layout-grid mission-grid">
                      <div class="mission-left">
                        <div class="mission-v3-foot">
                          <div class="divider-line mission"></div>
                          <p class="mission-summary">A built environment worth inheriting: homes, studios and workplaces that still work in fifty years because use came before style.</p>
                        </div>
                      </div>
                      <div class="mission-right"><img src="/images/Container-21.webp" loading="lazy" sizes="100vw" srcset="/images/Container-21-p-500.webp 500w, /images/Container-21-p-800.webp 800w, /images/Container-21.webp 1008w" alt="Five diverse professionals gathered around a table in an office, discussing architectural blueprints, with one man pointing to the plans while others listen and engage." class="mission-image" /></div>
                    </div>
                  </div>
                  <div data-w-tab="Tab 3" class="w-tab-pane">
                    <div class="w-layout-grid mission-grid">
                      <div class="mission-left">
                        <div class="mission-v3-foot">
                          <div class="divider-line mission"></div>
                          <p class="mission-summary">Every project begins in section rather than plan. Where the light falls and how deep a room can be are settled before any elevation.</p>
                        </div>
                      </div>
                      <div class="mission-right"><img src="/images/Container-20.webp" loading="lazy" sizes="100vw" srcset="/images/Container-20-p-500.webp 500w, /images/Container-20-p-800.webp 800w, /images/Container-20.webp 1008w" alt="Four people gathered around a large architectural model of an urban area on a table, examining and discussing it in a room with large windows overlooking trees and buildings." class="mission-image" /></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section page-bg">
        <div class="section-gap large">
          <div class="container">
            <div class="v2-section-stack">
              <div class="head-center">
                <div class="section-badge">
                  <div class="section-badge-mark"></div>
                  <p class="font-label">Journey</p>
                </div>
                <h2 class="section-heading-large">Our journey</h2>
              </div>
              <div class="journey-v3">
                <div class="journey-v3-line">
                  <div class="journey-animated-line"></div>
                </div>
                <div to-top-0="" class="journey-v3-row">
                  <div class="media-frame journey-v3 left-main"><img src="/images/Container-24.webp" alt="Modern home office setup with a wooden desk holding a large monitor, keyboard, tablet, lamp, and decorative plants, next to a large window with gray curtains and a tall potted plant." sizes="100vw" srcset="/images/Container-24-p-500.webp 500w, /images/Container-24-p-800.webp 800w, /images/Container-24-p-1080.webp 1080w, /images/Container-24.webp 1360w" loading="lazy" class="journey-image" />
                    <div class="journey-v3-node left">
                      <div class="journey-v3-arm"></div>
                      <div class="journey-v3-dot"></div>
                    </div>
                  </div>
                  <div id="w-node-_044c5918-3cb8-1e05-a1c8-54efb9bc5eb6-64c9cd77" class="journey-v3-text">
                    <div class="font-h5 body-font">2008</div>
                    <p class="journey-summary">Founded above a joinery workshop by two architects who wanted to hold the drawing, the budget and the build in one place, starting with a single house on the board.</p>
                  </div>
                </div>
                <div to-top-0="" class="journey-v3-row _02">
                  <div id="w-node-_6d2278b5-f591-479d-e0f3-a452fce1dd11-64c9cd77" class="journey-v3-text align-right">
                    <div class="font-h5 body-font">2012</div>
                    <p class="journey-summary">We took premises of our own and grew to twelve, adding the engineers and interior designers the work had started to need rather than subcontracting the thinking out.</p>
                  </div>
                  <div class="media-frame journey-v3 right-main">
                    <div class="journey-v3-node">
                      <div class="journey-v3-dot"></div>
                      <div class="journey-v3-arm"></div>
                    </div><img src="/images/Container-25.webp" alt="Spacious living room with high ceilings and large windows showing green trees outside, featuring cream-colored sofas with throw pillows, a glass coffee table with books and a flower arrangement, a floor lamp, a plush white rug, and a potted plant near the windows." sizes="(max-width: 1360px) 100vw, 1360px" srcset="/images/Container-25-p-500.webp 500w, /images/Container-25-p-800.webp 800w, /images/Container-25-p-1080.webp 1080w, /images/Container-25.webp 1360w" loading="lazy" class="journey-image" />
                  </div>
                </div>
                <div to-top-0="" class="journey-v3-row _03">
                  <div class="media-frame journey-v3 left-main"><img src="/images/Container-26.webp" alt="Minimalist living room with beige walls and wooden flooring, featuring a low wooden coffee table on a textured rug, a sideboard with a triangular wall hanging above, potted plants on either side, a pendant light, and a chair near large windows letting in natural light." sizes="(max-width: 1360px) 100vw, 1360px" srcset="/images/Container-26-p-500.webp 500w, /images/Container-26-p-800.webp 800w, /images/Container-26-p-1080.webp 1080w, /images/Container-26.webp 1360w" loading="lazy" class="journey-image" />
                    <div class="journey-v3-node">
                      <div class="journey-v3-arm"></div>
                      <div class="journey-v3-dot"></div>
                    </div>
                  </div>
                  <div id="w-node-_0ba8586b-15a6-7eb6-f763-9e8810235d77-64c9cd77" class="journey-v3-text">
                    <div class="font-h5 body-font">2015</div>
                    <p class="journey-summary">A first national award arrived in the same year as a commission abroad, and the portfolio finally read as a body of work rather than a list of unrelated jobs done.</p>
                  </div>
                </div>
                <div to-top-0="" class="journey-v3-row _04">
                  <div id="w-node-_307f8f93-e1a1-cf66-2e61-552486f688f2-64c9cd77" class="journey-v3-text align-right">
                    <div class="font-h5 body-font">2026</div>
                    <p class="journey-summary">Two hundred projects delivered, six in ten of them reworking a building that already stood, because the greenest material on any site is the one already standing.</p>
                  </div>
                  <div class="media-frame journey-v3 right-main">
                    <div class="journey-v3-node">
                      <div class="journey-v3-dot"></div>
                      <div class="journey-v3-arm"></div>
                    </div><img src="/images/Container-27.webp" alt="Three-story modern building made from stacked black shipping containers with large windows, glass balconies, climbing plants on the exterior, and lush greenery on the roof, set against the backdrop of other contemporary buildings and trees at sunset." sizes="(max-width: 1360px) 100vw, 1360px" srcset="/images/Container-27-p-500.webp 500w, /images/Container-27-p-800.webp 800w, /images/Container-27-p-1080.webp 1080w, /images/Container-27.webp 1360w" loading="lazy" class="journey-image" />
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section black-900">
        <div class="section-gap large">
          <div class="container">
            <div class="v2-section-stack">
              <div class="head-center left-mobile">
                <div class="section-badge">
                  <div class="section-badge-mark white"></div>
                  <p class="font-label white">Awards</p>
                </div>
                <h2 class="section-heading-large white-100 left-mobile">Awards &amp; Honors</h2>
              </div>
              <div class="award-list">
                <div to-top-0="" class="award-row-v3">
                  <div class="award-left">
                    <p class="font-small">(2026)</p>
                    <div class="award-v3-title">
                      <div class="award-title">Residential Design</div>
                      <p class="font-small">Architizer A+ Awards</p>
                    </div>
                  </div>
                  <div class="award-logo-wrap">
                    <div class="award-logo-block"><Fragment set:html={awardLogo10Svg} /></div>
                  </div>
                  <p class="award-summary-v3">Recognized with the Ji.Hlava IDFF Special Mention for spatial storytelling that capture.</p>
                </div>
                <div to-top-0="" class="award-row-v3">
                  <div class="award-left">
                    <p class="font-small">(2025)</p>
                    <div class="award-v3-title">
                      <div class="award-title">Sustainable Structure</div>
                      <p class="font-small">Dezeen Awards</p>
                    </div>
                  </div>
                  <div class="award-logo-wrap">
                    <div class="award-logo-block"><Fragment set:html={awardLogo11Svg} /></div>
                  </div>
                  <p class="award-summary-v3">An Official Selection at Roma CinemaDoc for designs</p>
                </div>
                <div to-top-0="" class="award-row-v3">
                  <div class="award-left">
                    <p class="font-small">(2024)</p>
                    <div class="award-v3-title">
                      <div class="award-title">Interior&nbsp;&nbsp;Structure</div>
                      <p class="font-small">Architizer A+ Awards</p>
                    </div>
                  </div>
                  <div class="award-logo-wrap">
                    <div class="award-logo-block"><Fragment set:html={awardLogo12Svg} /></div>
                  </div>
                  <p class="award-summary-v3">Premio Giuria Popolare Winner, celebrated by public juries </p>
                </div>
                <div to-top-0="" class="award-row-v3">
                  <div class="award-left">
                    <p class="font-small">(2023)</p>
                    <div class="award-v3-title">
                      <div class="award-title">Urban Architecture</div>
                      <p class="font-small">Architizer A+ Awards</p>
                    </div>
                  </div>
                  <div class="award-logo-wrap">
                    <div class="award-logo-block"><Fragment set:html={awardLogo13Svg} /></div>
                  </div>
                  <p class="award-summary-v3">Winner of the Premio Giuria recognized for iconic designs</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section page-bg">
        <div class="section-gap large">
          <div class="container">
            <div class="v2-section-stack">
              <div class="head-center">
                <div class="section-badge">
                  <div class="section-badge-mark"></div>
                  <p class="font-label">Team</p>
                </div>
                <h2 class="section-heading-large">Behind The Team</h2>
              </div>
              <div class="team-v3-grid">
                <div to-top-0="" class="team-v3-card col-1">
                  <div class="media-frame team-v3"><img src="/images/Image-Design-yours-18.webp" alt="Modern single-story house with large glass windows and concrete roof, surrounded by green lawn, shrubs, and trees under clear blue sky." sizes="(max-width: 1144px) 100vw, 1144px" srcset="/images/Image-Design-yours-18-p-500.webp 500w, /images/Image-Design-yours-18-p-800.webp 800w, /images/Image-Design-yours-18-p-1080.webp 1080w, /images/Image-Design-yours-18.webp 1144w" loading="lazy" class="team-image-v3" /></div>
                  <div class="team-v3-meta">
                    <div class="card-title body-font">Sophia</div>
                    <p class="font-small">Lead Interior Designer</p>
                  </div>
                </div>
                <div class="blank"></div>
                <div to-top-0="" class="team-v3-card">
                  <div class="media-frame team-v3"><img src="/images/Image-Design-yours-15.webp" alt="Modern single-story building with large floor-to-ceiling glass windows and concrete exterior surrounded by landscaped greenery and trees under a clear blue sky." sizes="100vw" srcset="/images/Image-Design-yours-15-p-500.webp 500w, /images/Image-Design-yours-15-p-800.webp 800w, /images/Image-Design-yours-15.webp 858w" loading="lazy" class="team-image-v3" /></div>
                  <div class="team-v3-meta">
                    <div class="card-title body-font">Olivia</div>
                    <p class="font-small">Interior Design Specialist</p>
                  </div>
                </div>
                <div to-top-0="" class="team-v3-card">
                  <div class="media-frame team-v3"><img src="/images/Image-Design-yours-16-1.webp" alt="Modern rectangular building with large glass windows, surrounded by landscaped greenery and trees under a clear blue sky." sizes="(max-width: 1107px) 100vw, 1107px" srcset="/images/Image-Design-yours-16-1-p-500.webp 500w, /images/Image-Design-yours-16-1-p-800.webp 800w, /images/Image-Design-yours-16-1-p-1080.webp 1080w, /images/Image-Design-yours-16-1.webp 1107w" loading="lazy" class="team-image-v3" /></div>
                  <div class="team-v3-meta">
                    <div class="card-title body-font">Emma</div>
                    <p class="font-small">Residential Interior Designer</p>
                  </div>
                </div>
