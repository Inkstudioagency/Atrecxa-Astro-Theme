                      </div>
                    </div>
                  </div>
                </div>
                <div class="journey-v2-track">
                  <div class="journey-animated-line-v2"></div>
                  <div class="journey-v2-item">
                    <div class="journey-v2-top">
                      <div class="journey-v2-card">
                        <div class="font-h5 body-font">Shaping the Future</div>
                        <div class="media-frame journey-v2"><img src="/images/Container-27.webp" alt="A multi-story industrial-style building made of corrugated metal panels with rust patches, set in a desert landscape with a clear sky at sunset." sizes="(max-width: 1360px) 100vw, 1360px" srcset="/images/Container-27-p-500.webp 500w, /images/Container-27-p-800.webp 800w, /images/Container-27-p-1080.webp 1080w, /images/Container-27.webp 1360w" class="journey-image-v2" /></div>
