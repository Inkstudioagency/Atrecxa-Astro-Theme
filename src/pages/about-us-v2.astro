              <div class="marque-wrap">
                <div class="marque-list"><img src="/images/Company-logo-7.webp" loading="lazy" alt="Eclipseful" class="company-logo-image" /><img src="/images/Company-logo-5.webp" loading="lazy" alt="Capsule company logo." class="company-logo-image" /><img src="/images/Company-logo-8.webp" loading="lazy" alt="Foresight" class="company-logo-image" /><img src="/images/Company-logo-6.webp" loading="lazy" alt="CloudWatch logo showing a stylized cloud icon followed by the word 'CloudWatch' in bold black font." class="company-logo-image" /><img src="/images/Company-logo.webp" loading="lazy" alt="Goodwell company logo with a stylized lowercase 'g' icon to the left of the word 'Goodwell'." class="company-logo-image" /><img src="/images/Company-logo-2.webp" loading="lazy" alt="Railspeed company logo with stylized horizontal bars next to the word Railspeed." class="company-logo-image" /><img src="/images/Company-logo-4.webp" loading="lazy" alt="Leapyear company logo with a stylized geometric icon to the left of the word 'Leapyear' in bold black font." class="company-logo-image" /><img src="/images/Company-logo-1.webp" loading="lazy" alt="Radius company logo with a starburst design to the left of the word Radius in bold font." class="company-logo-image" /><img src="/images/Company-logo-3.webp" loading="lazy" alt="Norse Star company logo with a black abstract star symbol followed by the words 'Norse Star' in black text." class="company-logo-image" /></div>
                <div class="marque-list"><img src="/images/Company-logo-7.webp" loading="lazy" alt="Eclipseful" class="company-logo-image" /><img src="/images/Company-logo-5.webp" loading="lazy" alt="Capsule company logo." class="company-logo-image" /><img src="/images/Company-logo-8.webp" loading="lazy" alt="Foresight" class="company-logo-image" /><img src="/images/Company-logo-6.webp" loading="lazy" alt="CloudWatch logo showing a stylized cloud icon followed by the word 'CloudWatch' in bold black font." class="company-logo-image" /><img src="/images/Company-logo.webp" loading="lazy" alt="Goodwell company logo with a stylized lowercase 'g' icon to the left of the word 'Goodwell'." class="company-logo-image" /><img src="/images/Company-logo-2.webp" loading="lazy" alt="Railspeed company logo with stylized horizontal bars next to the word Railspeed." class="company-logo-image" /><img src="/images/Company-logo-4.webp" loading="lazy" alt="Leapyear company logo with a stylized geometric icon to the left of the word 'Leapyear' in bold black font." class="company-logo-image" /><img src="/images/Company-logo-1.webp" loading="lazy" alt="Radius company logo with a starburst design to the left of the word Radius in bold font." class="company-logo-image" /><img src="/images/Company-logo-3.webp" loading="lazy" alt="Norse Star company logo with a black abstract star symbol followed by the words 'Norse Star' in black text." class="company-logo-image" /></div>
                <div class="marque-overlay"></div>
                <div class="marque-overlay right"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <section class="section page-bg">
      <div class="section-gap large">
        <div class="container">
          <div class="v2-section-stack">
            <div class="head-center">
              <div class="section-badge">
                <div class="section-badge-mark"></div>
                <p class="font-label">Journey</p>
              </div>
              <h2 class="section-heading-large">Our journey</h2>
            </div>
            <div class="journey-sticky-wrapper">
              <div class="journey-list-wrap">
                <div class="journey-v2-track">
                  <div class="journey-animated-line-v2"></div>
                  <div class="journey-v2-item">
                    <div class="journey-v2-top padding-none">
                      <div class="about-rebuild-text body-font">2008</div>
                      <div class="journey-v2-stem">
                        <div class="journey-v2-stem-line"></div>
                        <div class="journey-v2-stem-dot"></div>
                      </div>
                    </div>
                    <div class="journey-v2-bottom">
                      <div class="journey-v2-card">
                        <div class="font-h5 body-font">The First Spark</div>
                        <div class="media-frame journey-v2"><img src="/images/Container-17.webp" alt="Modern home office setup with a wooden desk featuring a desktop computer with a black screen, a laptop, a keyboard, mouse, decorative items, and books on shelves above, next to a large window with grey curtains and a potted plant." sizes="(max-width: 1020px) 100vw, 1020px" srcset="/images/Container-17-p-500.webp 500w, /images/Container-17-p-800.webp 800w, /images/Container-17.webp 1020w" class="journey-image-v2" /></div>
                        <p class="font-regular">Two architects, one borrowed room above a joinery workshop, and one house to draw.</p>
                      </div>
                    </div>
                  </div>
                  <div class="journey-v2-item">
                    <div class="journey-v2-top">
                      <div class="journey-v2-card">
                        <div class="font-h5 body-font-copy">Building Our Vision</div>
                        <div class="media-frame journey-v2"><img src="/images/Container-16.webp" alt="A multi-story industrial-style building made of corrugated metal panels with rust patches, set in a desert landscape with a clear sky at sunset." sizes="(max-width: 1020px) 100vw, 1020px" srcset="/images/Container-16-p-500.webp 500w, /images/Container-16-p-800.webp 800w, /images/Container-16.webp 1020w" class="journey-image-v2" /></div>
