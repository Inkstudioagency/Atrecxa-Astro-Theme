                      </div>
                    </div>
                    <div class="journey-v2-bottom padding-none">
                      <div class="journey-v2-stem">
                        <div class="journey-v2-stem-dot"></div>
                        <div class="journey-v2-stem-line"></div>
                      </div>
                      <p class="about-rebuild-text body-font">2012</p>
                    </div>
