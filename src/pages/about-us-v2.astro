---
import BlogCardV2 from '../components/cards/BlogCardV2.astro';
import BlogSideCardV2 from '../components/cards/BlogSideCardV2.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import awardLogoV27Svg from '../assets/svg/award-logo-v2-7.svg?raw';
import awardLogoV28Svg from '../assets/svg/award-logo-v2-8.svg?raw';
import awardLogoV29Svg from '../assets/svg/award-logo-v2-9.svg?raw';
import TestimonialsV2 from '../components/sections/TestimonialsV2.astro';
import FaqV2 from '../components/sections/FaqV2.astro';
import PrimaryButton from '../components/ui/PrimaryButton.astro';
import CtaV2 from '../components/sections/CtaV2.astro';
import Footer from '../components/global/Footer.astro';
import { getBlogs } from '../lib/cms';

const blogs = await getBlogs();
const blogs0 = blogs.slice(0, 1);
const blogs1 = blogs.slice(1, 3);
---

<BaseLayout title="About Us V2 - Atrecxa - Astro Theme" description="About Us V2 page of the Atrecxa Astro theme — an alternate studio story layout with mission, journey timeline, awards and team profiles." wfPage="6aa1657995f946b2d560ae14">
<div class="page-wrapper">
    <Header variant="dark" />
    <section class="section hero-v2">
      <div class="home-hero-top">
        <div class="about-hero-head">
          <h1 class="font-h1">Our</h1>
          <div class="devider-line"></div>
          <div class="font-h1">Story</div>
        </div>
      </div>
      <div class="about-hero"><img src="/images/Hero.webp" loading="eager" sizes="(max-width: 4320px) 100vw, 4320px" srcset="/images/Hero-p-500.webp 500w, /images/Hero-p-800.webp 800w, /images/Hero-p-1080.webp 1080w, /images/Hero-p-1600.webp 1600w, /images/Hero-p-2000.webp 2000w, /images/Hero.webp 4320w" alt="Modern minimalist white house with large floor-to-ceiling glass windows, surrounded by steps and green shrubbery." class="about-hero-image-02" /><img src="/images/9a958679e21fb9a2eeeab6a9603b29a75c9d1e4c.webp" loading="eager" sizes="(max-width: 1678px) 100vw, 1678px" srcset="/images/9a958679e21fb9a2eeeab6a9603b29a75c9d1e4c-p-500.webp 500w, /images/9a958679e21fb9a2eeeab6a9603b29a75c9d1e4c-p-800.webp 800w, /images/9a958679e21fb9a2eeeab6a9603b29a75c9d1e4c-p-1080.webp 1080w, /images/9a958679e21fb9a2eeeab6a9603b29a75c9d1e4c-p-1600.webp 1600w, /images/9a958679e21fb9a2eeeab6a9603b29a75c9d1e4c.webp 1678w" alt="Modern minimalist glass house with large floor-to-ceiling windows, white exterior walls, broad flat roof, and wide concrete steps leading to the entrance, surrounded by green trimmed hedges." class="about-media-image" /></div>
    </section>
    <section class="section white">
      <div class="section-gap large">
        <div class="container">
          <div class="v2-section-stack">
            <div class="head-center">
              <div class="section-badge">
                <div class="section-badge-mark"></div>
                <p class="font-label">About</p>
              </div>
              <div class="max-width-55">
                <h2 class="rebuild-text">We Design Interiors That Blend Style, Comfort, And Functionality. With A Passion For Detail And A Focus On Timeless Elegance</h2>
              </div>
            </div>
            <div class="vission-grid">
              <div to-top-0="" class="media-frame about-v2-column hide-tab"><img class="media-image" src="/images/Image-single-image-3.webp" alt="Modern building with large floor-to-ceiling glass windows, light stone steps leading up to the entrance, and neatly trimmed green bushes in front under a clear blue sky." sizes="100vw" parallax="" loading="lazy" srcset="/images/Image-single-image-3-p-500.webp 500w, /images/Image-single-image-3-p-800.webp 800w, /images/Image-single-image-3-p-1080.webp 1080w, /images/Image-single-image-3.webp 1232w" /></div>
              <div to-top-2="" class="about-v2-pillars">
                <div class="about-v2-pillar _01">
                  <div class="about-v2-pillar-row _01">
                    <div class="vission-title">Our mission</div>
                    <div class="about-v2-pillar-icon"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 32 32" fill="none" class="vission-logo">
                        <path d="M8.29171 15.4907L4.41589 14.9838C3.62196 14.8809 3.09181 14.1122 3.44468 13.3945C4.56701 11.1116 7.49271 8.47257 12.9865 8.9078M8.29171 15.4907C9.69931 13.1391 11.429 10.6725 12.9865 8.9078M8.29171 15.4907L15.8427 23.0417M12.9865 8.9078C17.8807 3.45323 22.8994 2.30408 26.125 2.75588C27.4011 2.93461 28.3988 3.93231 28.5776 5.20843C29.0294 8.43409 27.8802 13.4527 22.4256 18.3469M15.8427 23.0417L16.3496 26.9175C16.4526 27.7115 17.2212 28.2417 17.939 27.8887C20.2219 26.7665 22.8608 23.8407 22.4256 18.3469M15.8427 23.0417C18.1943 21.6341 20.6608 19.9043 22.4256 18.3469" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M23.3333 10.6667C23.3333 9.19391 22.1395 8 20.6667 8C19.1939 8 18 9.19391 18 10.6667C18 12.1394 19.1939 13.3333 20.6667 13.3333C22.1395 13.3333 23.3333 12.1394 23.3333 10.6667Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M5.33337 29.3334L10.6667 24.0001M5.33337 22.6667L7.33337 20.6667" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg></div>
                  </div>
                  <div class="vission-summary-wrap _01">
                    <p class="vission-summary _01">To design buildings and interiors as one act of thinking, with a single team holding the drawing, the budget and the build, so that what is handed over is exactly what was promised at the start.</p>
                  </div>
                </div>
                <div class="about-v2-pillar _02">
                  <div class="about-v2-pillar-row _02">
                    <div class="vission-title">Our Vision</div>
                    <div class="about-v2-pillar-icon"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 32 32" fill="none" class="vission-logo">
                        <path d="M20.1749 3.33341C18.8616 2.90081 17.4581 2.66675 16 2.66675C8.63616 2.66675 2.66663 8.63628 2.66663 16.0001C2.66663 23.3638 8.63616 29.3334 16 29.3334C23.3637 29.3334 29.3333 23.3638 29.3333 16.0001C29.3333 14.6065 29.1194 13.2628 28.7229 12.0001" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                        <path d="M22.6667 15.9999C22.6667 19.6818 19.6819 22.6666 16 22.6666C12.3181 22.6666 9.33337 19.6818 9.33337 15.9999C9.33337 12.318 12.3181 9.33325 16 9.33325" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M26 6.00008L16 16.0001M26 6.00008V2.66675M26 6.00008H29.3333" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                      </svg></div>
                  </div>
                  <div class="vission-summary-wrap _02">
                    <p class="vission-summary _02">A built environment worth inheriting. Homes, studios and workplaces that still work fifty years from now, because they were planned around daylight, material and use rather than around style.</p>
                  </div>
                </div>
                <div class="about-v2-pillar _03">
                  <div class="about-v2-pillar-row _03">
                    <div class="vission-title">Our Philosophy</div>
                    <div class="about-v2-pillar-icon"><svg xmlns="http://www.w3.org/2000/svg" width="100%" viewBox="0 0 32 32" fill="none" class="vission-logo">
                        <path d="M28 13.3333V17.3333C28 22.3616 28 24.8759 26.4379 26.4379C24.8759 28 22.3616 28 17.3333 28H14.6667C9.63835 28 7.1242 28 5.56209 26.4379C4 24.8759 4 22.3616 4 17.3333V14.6667C4 9.63835 4 7.1242 5.56209 5.56209C7.1242 4 9.63835 4 14.6667 4H18.6667" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M13.3334 4L20 27.3333" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M4 17.3334L16 14.6667" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                        <path d="M26 3.91675V6.00008M26 6.00008V8.08341M26 6.00008H24.3333M26 6.00008H27.6666M29.3333 6.00008L27.8874 5.51811C27.2238 5.29692 26.7032 4.77623 26.482 4.11265L26 2.66675L25.518 4.11265C25.2968 4.77623 24.7761 5.29692 24.1125 5.51811L22.6666 6.00008L24.1125 6.48205C24.7761 6.70324 25.2968 7.22393 25.518 7.88751L26 9.33341L26.482 7.88751C26.7032 7.22393 27.2238 6.70324 27.8874 6.48205L29.3333 6.00008Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
                      </svg></div>
                  </div>
                  <div class="vission-summary-wrap _03">
                    <p class="vission-summary _03">Every project begins in section rather than in plan. Where the light falls, how the ground moves and how deep a room can be before it stops working are settled before an elevation is drawn.</p>
                  </div>
                </div>
              </div>
              <div to-top-4="" class="media-frame about-v2-column"><img class="media-image" src="/images/Image-single-image-5.webp" alt="Three-story modern house made of stacked shipping containers painted black, featuring large windows, a small wooden deck with chairs and table, and plants on the rooftop and around the base, illuminated by golden sunset light in an urban setting." sizes="(max-width: 822px) 100vw, 822px" parallax="" loading="lazy" srcset="/images/Image-single-image-5-p-500.webp 500w, /images/Image-single-image-5-p-800.webp 800w, /images/Image-single-image-5.webp 822w" /></div>
            </div>
            <div to-top-0="" class="marque-main">
              <div class="marque-badge-wrap">
                <div class="hero-badge-text light">Trusted by industry-leading Brands</div>
