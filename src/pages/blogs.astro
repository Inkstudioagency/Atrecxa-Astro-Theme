---
import BlogFeaturedCard from '../components/cards/BlogFeaturedCard.astro';
import BlogGridCard from '../components/cards/BlogGridCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import Footer from '../components/global/Footer.astro';
import { getBlogs, byOrderAsc } from '../lib/cms';

const blogs = await getBlogs();
const blogs0 = byOrderAsc(blogs).slice(0, 1);
const blogs1 = blogs.slice(1);
---

<BaseLayout title="Blogs - Atrecxa - Astro Theme" description="Blog page of the Atrecxa Astro theme — a CMS-powered journal for notes on architecture, interiors, materials and studio process." wfPage="6a9fb87458d2e531d85a2e6b">
<div class="page-wrapper">
    <div class="blog-hero"><img src="/images/Rectangle-1-3.webp" loading="eager" sizes="(max-width: 2880px) 100vw, 2880px" srcset="/images/Rectangle-1-3-p-500.webp 500w, /images/Rectangle-1-3-p-800.webp 800w, /images/Rectangle-1-3-p-1080.webp 1080w, /images/Rectangle-1-3-p-1600.webp 1600w, /images/Rectangle-1-3-p-2000.webp 2000w, /images/Rectangle-1-3.webp 2880w" alt="Two men sitting in a modern living room reading books; an older man in a denim jacket and jeans on a brown chair, and a younger man in a dark shirt and khaki pants on a gray sofa, with a round black metal and wooden coffee table holding books and mugs between them." class="inner-hero-image" />
      <Header />
      <section class="section blog-hero-main">
        <div class="w-layout-blockcontainer container w-container">
          <div class="blog-hero-content">
            <div class="featured-wrapper w-dyn-list">{blogs0.length > 0 ? (<div role="list" class="w-dyn-items">{blogs0.map((entry) => (<div role="listitem" class="w-dyn-item"><BlogFeaturedCard item={entry} /></div>))}</div>) : (null)}</div>
            <h1 class="font-h1 blog-title">Blogs</h1>
          </div>
        </div>
      </section>
      <div class="hero-overlay"></div>
    </div>
    <div class="main">
      <section class="section white-50">
        <div class="section-gap large">
          <div class="w-layout-blockcontainer container w-container">
            <div class="section-head">
              <div class="section-badge">
                <div class="section-badge-mark"></div>
                <p class="font-label">Blogs</p>
              </div>
              <h2 class="section-heading-v1">Latest Articles</h2>
            </div>
            <div class="w-dyn-list">{blogs1.length > 0 ? (<div role="list" class="grid-3 blog w-dyn-items">{blogs1.map((entry) => (<div role="listitem" class="w-dyn-item"><BlogGridCard item={entry} /></div>))}</div>) : (null)}</div>
          </div>
        </div>
      </section>
      <Footer />
    </div>
  </div>
</BaseLayout>
