---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/global/Header.astro';
import PrimaryButton from '../components/ui/PrimaryButton.astro';
import graphic3Svg from '../assets/svg/graphic-3.svg?raw';
import graphic4Svg from '../assets/svg/graphic-4.svg?raw';
import graphic5Svg from '../assets/svg/graphic-5.svg?raw';
import graphic6Svg from '../assets/svg/graphic-6.svg?raw';
import TestimonialsV1 from '../components/sections/TestimonialsV1.astro';
import FaqV1 from '../components/sections/FaqV1.astro';
import LatestArticlesV1 from '../components/sections/LatestArticlesV1.astro';
import ContactCta from '../components/sections/ContactCta.astro';
import Footer from '../components/global/Footer.astro';
---

<BaseLayout title="About Us V1 - Atrecxa - Astro Theme" description="About Us V1 page of the Atrecxa Astro theme — tell your studio story, share your vision and introduce the architects and designers behind the work." wfPage="6a9ec280e51c6fb372b62089">
<div class="page-wrapper">
    <div class="about-hero-area"><img src="/images/Rectangle-1-4.webp" loading="eager" sizes="(max-width: 1439px) 100vw, 1440px" srcset="/images/Rectangle-1-4-p-500.webp 500w, /images/Rectangle-1-4-p-800.webp 800w, /images/Rectangle-1-4-p-1080.webp 1080w, /images/Rectangle-1-4.webp 1440w" alt="Modern glass-walled pavilion with flat roof and white stone steps surrounded by green trees and hedges under a clear blue sky." class="inner-hero-image" />
      <Header />
      <section class="section hero-center">
        <div class="w-layout-blockcontainer container w-container">
          <div class="about-hero-content">
            <div class="inner-heading-wrap">
              <h1 class="font-h1 white-50">Our</h1>
              <div class="devider-line white"></div>
              <div class="font-h1 white-50">Story</div>
            </div>
            <div class="inner-button-wrap">
              <PrimaryButton href="/contact-us">Get in touch</PrimaryButton>
            </div>
          </div>
        </div>
      </section>
      <div class="hero-overlay"></div>
    </div>
    <div class="main">
      <section class="section white">
        <div class="section-gap large">
          <div class="w-layout-blockcontainer container w-container">
            <div class="work-head">
              <div class="section-badge">
                <div class="section-badge-mark"></div>
                <div class="font-label">About</div>
              </div>
              <div class="max-width-53">
                <h2 class="rebuild-text">We Design Interiors That Blend Style, Comfort, And Functionality. With A Passion For Detail And A Focus On Timeless Elegance</h2>
              </div>
            </div>
            <div class="about-split">
              <div to-top-0="" class="split-column">
                <div class="text-stack">
                  <h3 class="font-h5 body-font">Our Vision</h3>
                  <p class="font-regular">To redefine the built environment by shaping enduring, human-centric spaces that harmonize cutting-edge design with environmental responsibility.</p>
                </div>
                <div class="media-frame landscape"><img class="vission-image" src="/images/Rectangle-45.webp" alt="Modern living room with large floor-to-ceiling windows showing a city skyline at sunset, featuring white sectional sofa, dark coffee tables, and sheer curtains." sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px" parallax="" loading="lazy" srcset="/images/Rectangle-45-p-500.webp 500w, /images/Rectangle-45-p-800.webp 800w, /images/Rectangle-45.webp 951w" /></div>
              </div>
              <div to-top-2="" id="w-node-_2d9123d1-50cf-87c7-bc69-271e976d9bd9-72b62089" class="media-frame _02"><img class="vission-image-large" src="/images/Rectangle-46-2.webp" alt="Close-up of an ornate beige building facade with detailed classical architectural elements, arched windows, sculpted figures, and a balcony, beside a tree with light pink blossoms." sizes="(max-width: 479px) 100vw, 389px" parallax="" loading="lazy" srcset="/images/Rectangle-46-2-p-500.webp 500w, /images/Rectangle-46-2-p-800.webp 800w, /images/Rectangle-46-2.webp 810w" /></div>
              <div to-top-4="" class="split-column">
                <div class="media-frame tall"><img class="vission-image-small" src="/images/Rectangle-42.webp" alt="Modern concrete house with large glass windows reflecting the setting sun, surrounded by desert landscape with sand and sparse vegetation." sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px" parallax="" loading="lazy" srcset="/images/Rectangle-42-p-500.webp 500w, /images/Rectangle-42-p-800.webp 800w, /images/Rectangle-42.webp 951w" /></div>
                <div class="text-stack">
                  <h3 class="font-h5 body-font">Our Mission</h3>
                  <p class="font-regular">To deliver architecture through rigorous craftsmanship, considered spatial planning and real collaboration, making buildings that lift the streets.</p>
                </div>
              </div>
            </div>
            <div class="logo-section">
              <div class="logo-grid top">
                <div to-top-0="" class="logo-cell first"><img src="/images/Image-Client-Image-1.webp" loading="lazy" alt="3Portals company logo." class="company-logo" /></div>
                <div to-top-0="" class="logo-cell _02"><img src="/images/Image-Client-Image-2.webp" loading="lazy" alt="AlphaWave company logo with overlapping geometric shapes to the left of the text." class="company-logo" /></div>
                <div to-top-0="" id="w-node-fc2668a6-e5fd-60d4-1ddd-c477dfab5594-72b62089" class="logo-cell text">
                  <div class="max-width-10">
                    <div class="about-stats-title">Trusted by industry-leading Brands</div>
                  </div>
                </div>
                <div to-top-0="" class="logo-cell border-none-mobile"><img src="/images/Image-Client-Image-3.webp" loading="lazy" alt="Clandestine company logo with stylized cross symbol to the left of the word 'Clandestine'." class="company-logo" /></div>
                <div to-top-0="" class="logo-cell last"><img src="/images/Image-Client-Image-4.webp" loading="lazy" alt="Acme Corp" class="company-logo" /></div>
              </div>
              <div class="divider-line"></div>
              <div class="logo-grid bottom">
                <div to-top-0="" class="logo-cell first"><img src="/images/Image-Client-Image-5.webp" loading="lazy" alt="Boltshift company logo with a stylized lightning bolt inside a circle to the left of the company name in bold font." class="company-logo" /></div>
                <div to-top-0="" class="logo-cell"><img src="/images/Image-Client-Image-6.webp" loading="lazy" alt="Alt+Shift company logo with a circular icon featuring wavy horizontal lines next to the text 'Alt+Shift'." class="company-logo" /></div>
                <div to-top-0="" class="logo-cell border-none-mobile"><img src="/images/Image-Client-Image-7.webp" loading="lazy" alt="Kintsugi company logo featuring an eight-pointed star shape next to the word 'Kintsugi' in bold black font." class="company-logo" /></div>
                <div to-top-0="" class="logo-cell"><img src="/images/Image-Client-Image-8.webp" loading="lazy" alt="Calescence company logo with a geometric hexagonal design to the left of the word 'Calescence' in bold black text." class="company-logo" /></div>
                <div to-top-0="" id="w-node-fc2668a6-e5fd-60d4-1ddd-c477dfab55a5-72b62089" class="logo-cell last"><img src="/images/Image-Client-Image-9.webp" loading="lazy" alt="CoreOS wordmark logo with hexagon containing a right-pointing arrow." class="company-logo" /></div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section white-50">
        <div class="section-gap large">
          <div class="w-layout-blockcontainer container w-container">
            <div class="journey-sticky-wrap">
              <div class="journey-main">
                <div class="work-head">
                  <div class="section-badge">
                    <div class="section-badge-mark"></div>
                    <div class="font-label">Journey</div>
                  </div>
                  <h2 class="journey-heading">Our journey</h2>
                </div>
                <div to-top-0="" class="journey-marque">
                  <div class="journey-grid">
                    <div class="journey-card-v1 first">
                      <div class="year body-font">2008</div>
                      <p class="font-regular">Founded as a two-person studio above a joinery workshop, with one house on the board.</p>
                      <div class="media-frame journey"><img src="/images/Container-7.webp" loading="lazy" sizes="100vw" srcset="/images/Container-7-p-500.webp 500w, /images/Container-7-p-800.webp 800w, /images/Container-7-p-1080.webp 1080w, /images/Container-7.webp 1268w" alt="Modern, organized home office with a long wooden desk featuring a monitor, tablet, keyboard, and decorative plants, set against a backdrop of built-in shelves filled with books and storage boxes, next to a large window with grey curtains and a tall potted plant." class="media-image" /></div>
                    </div>
                    <div class="journey-card-v1">
                      <div class="year body-font">2012</div>
                      <p class="font-regular">Moved into our own premises and grew to twelve people across two design disciplines.</p>
                      <div class="media-frame journey"><img src="/images/Container-8.webp" loading="lazy" sizes="100vw" srcset="/images/Container-8-p-500.webp 500w, /images/Container-8-p-800.webp 800w, /images/Container-8-p-1080.webp 1080w, /images/Container-8.webp 1268w" alt="Tall, narrow, multi-story metal building with a rusted and weathered appearance stands in a desert landscape under clear sky, surrounded by sparse vegetation and scattered metal sculptures." class="media-image" /></div>
                    </div>
                    <div class="journey-card-v1 _03">
                      <div class="year body-font">2015</div>
                      <p class="font-regular">Won our first national award and completed a commission outside the country as well.</p>
                      <div class="media-frame journey"><img src="/images/Container-10.webp" loading="lazy" sizes="100vw" srcset="/images/Container-10-p-500.webp 500w, /images/Container-10-p-800.webp 800w, /images/Container-10-p-1080.webp 1080w, /images/Container-10.webp 1268w" alt="Spacious living room with large windows showing green outdoor trees, two beige sofas with patterned cushions, a glass coffee table with decorative items, a green potted plant, a soft rug, and a lamp on a side table." class="media-image" /></div>
                    </div>
                    <div class="journey-card-v1 last">
                      <div class="year body-font">2017</div>
                      <p class="font-regular">Brought interiors in-house, so one team carries a project from sketch to door handle.</p>
                      <div class="media-frame journey"><img src="/images/Container-11.webp" loading="lazy" sizes="100vw" srcset="/images/Container-11-p-500.webp 500w, /images/Container-11-p-800.webp 800w, /images/Container-11-p-1080.webp 1080w, /images/Container-11.webp 1268w" alt="Three-story modern modular building made from black shipping containers with large windows, glass balconies, and green vines climbing the walls and rooftop garden, set in an urban environment at sunset." class="media-image" /></div>
                    </div>
                  </div>
                  <div class="journey-grid">
                    <div class="journey-card-v1 first">
                      <div class="year body-font">2020</div>
                      <p class="font-regular">Rebuilt our specification around low-carbon materials and passive heating and cooling.</p>
                      <div class="media-frame journey"><img src="/images/Container-7.webp" loading="lazy" sizes="100vw" srcset="/images/Container-7-p-500.webp 500w, /images/Container-7-p-800.webp 800w, /images/Container-7-p-1080.webp 1080w, /images/Container-7.webp 1268w" alt="Modern, organized home office with a long wooden desk featuring a monitor, tablet, keyboard, and decorative plants, set against a backdrop of built-in shelves filled with books and storage boxes, next to a large window with grey curtains and a tall potted plant." class="media-image" /></div>
                    </div>
                    <div class="journey-card-v1">
                      <div class="year body-font">2022</div>
                      <p class="font-regular">Opened a second studio and handed over the hundredth building we had drawn</p>
                      <div class="media-frame journey"><img src="/images/Container-8.webp" loading="lazy" sizes="100vw" srcset="/images/Container-8-p-500.webp 500w, /images/Container-8-p-800.webp 800w, /images/Container-8-p-1080.webp 1080w, /images/Container-8.webp 1268w" alt="Tall, narrow, multi-story metal building with a rusted and weathered appearance stands in a desert landscape under clear sky, surrounded by sparse vegetation and scattered metal sculptures." class="media-image" /></div>
                    </div>
                    <div class="journey-card-v1">
                      <div class="year body-font">2024</div>
                      <p class="font-regular">Added a daylight and parametric modelling team that tests a plan before it is drawn.</p>
                      <div class="media-frame journey"><img src="/images/Container-10.webp" loading="lazy" sizes="100vw" srcset="/images/Container-10-p-500.webp 500w, /images/Container-10-p-800.webp 800w, /images/Container-10-p-1080.webp 1080w, /images/Container-10.webp 1268w" alt="Spacious living room with large windows showing green outdoor trees, two beige sofas with patterned cushions, a glass coffee table with decorative items, a green potted plant, a soft rug, and a lamp on a side table." class="media-image" /></div>
                    </div>
                    <div class="journey-card-v1 last">
                      <div class="year body-font">2026</div>
                      <p class="font-regular">Two hundred projects delivered, six in ten of them reworking a building already there.</p>
                      <div class="media-frame journey"><img src="/images/Container-11.webp" loading="lazy" sizes="100vw" srcset="/images/Container-11-p-500.webp 500w, /images/Container-11-p-800.webp 800w, /images/Container-11-p-1080.webp 1080w, /images/Container-11.webp 1268w" alt="Three-story modern modular building made from black shipping containers with large windows, glass balconies, and green vines climbing the walls and rooftop garden, set in an urban environment at sunset." class="media-image" /></div>
                    </div>
                  </div>
                </div>
                <div class="shape-wrap"><img src="/images/Frame-2147235099.png" loading="lazy" sizes="100vw" srcset="/images/11edca8c78dd59263f4594c22b5f3e3d_Frame-2147235099-p-800.png 800w, /images/11edca8c78dd59263f4594c22b5f3e3d_Frame-2147235099-p-1080.png 1080w, /images/11edca8c78dd59263f4594c22b5f3e3d_Frame-2147235099-p-1600.png 1600w, /images/11edca8c78dd59263f4594c22b5f3e3d_Frame-2147235099-p-2000.png 2000w, /images/11edca8c78dd59263f4594c22b5f3e3d_Frame-2147235099-p-2600.png 2600w, /images/11edca8c78dd59263f4594c22b5f3e3d_Frame-2147235099-p-3200.png 3200w, /images/Frame-2147235099.png 5760w" alt="A progress bar with multiple vertical white bars on a black background, with two orange bars near the center, indicating partial progress." class="shape" /><img src="/images/Frame-2147235099.png" loading="lazy" sizes="100vw" srcset="/images/11edca8c78dd59263f4594c22b5f3e3d_Frame-2147235099-p-800.png 800w, /images/11edca8c78dd59263f4594c22b5f3e3d_Frame-2147235099-p-1080.png 1080w, /images/11edca8c78dd59263f4594c22b5f3e3d_Frame-2147235099-p-1600.png 1600w, /images/11edca8c78dd59263f4594c22b5f3e3d_Frame-2147235099-p-2000.png 2000w, /images/11edca8c78dd59263f4594c22b5f3e3d_Frame-2147235099-p-2600.png 2600w, /images/11edca8c78dd59263f4594c22b5f3e3d_Frame-2147235099-p-3200.png 3200w, /images/Frame-2147235099.png 5760w" alt="A progress bar with multiple vertical white bars on a black background, with two orange bars near the center, indicating partial progress." class="shape" /></div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section inverse">
        <div class="section-gap large">
          <div class="w-layout-blockcontainer container w-container">
            <div class="split-grid award-v1">
              <div class="section-head faq">
                <div class="section-badge">
                  <div class="section-badge-mark white"></div>
                  <div class="font-label white">Testimonials</div>
                </div>
                <h2 class="section-heading-v1 white">Awards &amp; Honors</h2>
              </div>
              <div class="award-list">
                <div to-top-0="" class="award-row">
                  <div class="font-small award-year">(2026)</div>
                  <div class="text-stack tight">
                    <div class="award-title">Residential Design</div>
                    <div class="font-small company">Architizer A+ Awards</div>
                  </div>
                  <div class="award-icon-v1"><Fragment set:html={graphic3Svg} /></div>
                </div>
                <div to-top-0="" class="award-row">
                  <div class="font-small award-year">(2025)</div>
                  <div class="text-stack tight">
                    <div class="award-title">Sustainable Structure</div>
                    <div class="font-small company">Dezeen Awards</div>
                  </div>
                  <div class="award-icon-v1"><Fragment set:html={graphic4Svg} /></div>
                </div>
                <div to-top-0="" class="award-row">
                  <div class="font-small award-year">(2024)</div>
                  <div class="text-stack tight">
                    <div class="award-title">Interior Sanctuary of the Year</div>
                    <div class="font-small company">Architizer A+ Awards</div>
                  </div>
                  <div class="award-icon-v1"><Fragment set:html={graphic5Svg} /></div>
                </div>
                <div to-top-0="" class="award-row">
                  <div class="font-small award-year">(2023)</div>
                  <div class="text-stack tight">
                    <div class="award-title">Urban Architecture</div>
                    <div class="font-small company">Architizer A+ Awards</div>
                  </div>
                  <div class="award-icon-v1"><Fragment set:html={graphic6Svg} /></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <section class="section white">
        <div class="section-gap large">
          <div class="w-layout-blockcontainer container w-container">
            <div class="split-grid team">
              <div class="section-head faq">
                <div class="section-badge">
                  <div class="section-badge-mark"></div>
                  <div class="font-label">Team</div>
                </div>
                <h2 class="section-heading-v1">behind The team</h2>
              </div>
              <div class="team-cards">
                <div to-top-0="" class="team-card">
                  <div class="media-frame portrait"><img src="/images/Image-Design-yours-18.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px" srcset="/images/Image-Design-yours-18-p-500.webp 500w, /images/Image-Design-yours-18-p-800.webp 800w, /images/Image-Design-yours-18-p-1080.webp 1080w, /images/Image-Design-yours-18.webp 1144w" alt="Young man with curly dark hair, beard, and mustache wearing a black sweatshirt, smiling gently against a softly blurred indoor background with warm lighting." class="team-image" /></div>
                  <div class="team-info">
                    <h3 class="font-h5 body-font">Sophia</h3>
                    <div class="font-regular team">Lead Interior Designer</div>
                  </div>
                </div>
                <div to-top-0="" class="team-card">
                  <div class="media-frame portrait"><img src="/images/Image-Design-yours-16-1.webp" loading="lazy" sizes="100vw" srcset="/images/Image-Design-yours-16-1-p-500.webp 500w, /images/Image-Design-yours-16-1-p-800.webp 800w, /images/Image-Design-yours-16-1-p-1080.webp 1080w, /images/Image-Design-yours-16-1.webp 1107w" alt="Smiling young woman with wavy brown hair wearing a mustard-colored coat over a gray shirt, standing indoors with blurred background." class="team-image" /></div>
                  <div class="team-info">
                    <h3 class="font-h5 body-font">Emma</h3>
                    <div class="font-regular team">Interior Design Manager</div>
                  </div>
                </div>
                <div to-top-0="" class="team-card">
                  <div class="media-frame portrait"><img src="/images/Image-Design-yours-3_1.webp" loading="lazy" sizes="(max-width: 767px) 100vw, 531px" srcset="/images/Image-Design-yours-3_1-p-500.webp 500w, /images/Image-Design-yours-3_1-p-800.webp 800w, /images/Image-Design-yours-3_1-p-1080.webp 1080w, /images/Image-Design-yours-3_1.webp 1107w" alt="Smiling man with curly hair, a beard, and round glasses wearing a brown jacket over a dark shirt, sitting indoors in a warmly lit room with framed pictures and plants in the background." class="team-image" /></div>
                  <div class="team-info">
                    <h3 class="font-h5 body-font">Willam Paul</h3>
                    <div class="font-regular team">Interior Design Specialist</div>
                  </div>
                </div>
                <div to-top-0="" class="team-card">
                  <div class="media-frame portrait"><img src="/images/Image-Design-yours-4_1.webp" loading="lazy" sizes="(max-width: 767px) 100vw, 531px" srcset="/images/Image-Design-yours-4_1-p-500.webp 500w, /images/Image-Design-yours-4_1-p-800.webp 800w, /images/Image-Design-yours-4_1-p-1080.webp 1080w, /images/Image-Design-yours-4_1.webp 1107w" alt="Smiling young woman with curly hair wearing a brown leather jacket, hoop earrings, and layered necklaces in a softly lit indoor setting." class="team-image" /></div>
                  <div class="team-info">
                    <h3 class="font-h5 body-font">Olivia sean</h3>
                    <div class="font-regular team">Residential Interior Designer</div>
                  </div>
                </div>
                <div to-top-0="" class="team-card">
                  <div class="media-frame portrait"><img src="/images/Image-Design-yours-5.webp" loading="lazy" sizes="(max-width: 767px) 100vw, 531px" srcset="/images/Image-Design-yours-5-p-500.webp 500w, /images/Image-Design-yours-5-p-800.webp 800w, /images/Image-Design-yours-5-p-1080.webp 1080w, /images/Image-Design-yours-5.webp 1107w" alt="Portrait of a smiling young woman with wavy blonde hair, wearing a green shirt and brown jacket, standing indoors with blurred background." class="team-image" /></div>
                  <div class="team-info">
                    <h3 class="font-h5 body-font">Lina william</h3>
                    <div class="font-regular team">Space Planner</div>
                  </div>
                </div>
                <div to-top-0="" class="team-card">
                  <div class="media-frame portrait"><img src="/images/Image-Design-yours-6.webp" loading="lazy" sizes="(max-width: 767px) 100vw, (max-width: 991px) 728px, 940px" srcset="/images/Image-Design-yours-6-p-500.webp 500w, /images/Image-Design-yours-6-p-800.webp 800w, /images/Image-Design-yours-6-p-1080.webp 1080w, /images/Image-Design-yours-6.webp 1107w" alt="Young man with light facial hair wearing a black flat cap, olive green jacket, and black shirt, smiling against a dark blurred background." class="team-image" /></div>
                  <div class="team-info">
                    <h3 class="font-h5 body-font">Isabella</h3>
                    <div class="font-regular team">Retail Interior Designer</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
      <TestimonialsV1 />
      <FaqV1 />
      <LatestArticlesV1 />
      <ContactCta />
      <Footer />
    </div>
  </div>
</BaseLayout>
