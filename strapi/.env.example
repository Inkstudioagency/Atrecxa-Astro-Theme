HOST=0.0.0.0
PORT=1337

# Generate unique values for each of these (e.g. `openssl rand -base64 32`).
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# SQLite by default; switch DATABASE_CLIENT to postgres/mysql for production hosting.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Strapi MCP server (Streamable HTTP at /mcp). Set to false to disable.
MCP_ENABLED=true
