{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "Portfolio projects: listed on the home and projects pages, with a detail page at /project/[slug]"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "position": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "order": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "tagline": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "propertyType": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "architectureStyle": {
      "type": "string"
    },
    "completed": {
      "type": "date"
    },
    "interiorSpace": {
      "type": "string"
    },
    "propertyValue": {
      "type": "string"
    },
    "expertImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "overview": {
      "type": "richtext"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "overviewSecondary": {
      "type": "richtext"
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
