{
  "kind": "collectionType",
  "collectionName": "services",
  "info": {
    "singularName": "service",
    "pluralName": "services",
    "displayName": "Service",
    "description": "Studio services: listed on the home and services pages, with a detail page at /service/[slug]"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "position": {
      "type": "integer",
      "required": true,
      "default": 0
    },
    "shortDescription": {
      "type": "text"
    },
    "intro": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "stats": {
      "type": "component",
      "component": "shared.stat",
      "repeatable": true,
      "max": 3
    },
    "featureImages": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "overview": {
      "type": "richtext"
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "overviewSecondary": {
      "type": "richtext"
    },
    "included": {
      "type": "component",
      "component": "shared.text-item",
      "repeatable": true,
      "max": 5
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
