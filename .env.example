# Strapi (headless CMS). Used at build time only and never exposed to the browser.
# Leave STRAPI_URL empty to build from the bundled demo content (strapi/seed).
STRAPI_URL=http://localhost:1337
# Read-only API token: Strapi admin → Settings → API Tokens → Create new API Token → Token type "Read-only".
STRAPI_API_TOKEN=

# Public URL of the deployed site (canonical URLs, Open Graph, sitemap).
SITE_URL=https://example.com

# Endpoint that receives form submissions as JSON (Formspree, Web3Forms, Basin, a serverless function, ...).
# Leave empty to show the form's error state on submit.
PUBLIC_FORM_ENDPOINT=
